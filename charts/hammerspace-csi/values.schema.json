{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "namespace": {"type": "string", "minLength": 1},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "sidecars": {
      "type": "object", "additionalProperties": false,
      "required": ["pullPolicy"],
      "properties": {"pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}}
    },
    "controller": {
      "type": "object", "additionalProperties": false,
      "properties": {"replicas": {"type": "integer", "minimum": 1}, "leaderElection": {"type": "boolean"}}
    },
    "tls": {
      "type": "object", "additionalProperties": false,
      "properties": {"verify": {"type": "boolean"}, "caBundleSecretName": {"type": "string"}, "caBundleKey": {"type": "string"}}
    },
    "credentials": {"type": "object", "properties": {"existingSecret": {"type": "string", "minLength": 1}}},
    "observability": {"type": "object"},
    "storageClass": {"type": "object"},
    "snapshotClass": {"type": "object"},
    "imagePullSecrets": {"type": "array"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"}
  },
  "required": ["namespace", "image", "sidecars", "controller", "tls", "credentials"]
}
